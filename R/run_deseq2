function(counts, metadata, condition1, condition2) {
  # Subset data for the two conditions
  subset_metadata <- metadata %>% 
    filter(condition %in% c(condition1, condition2))
  subset_counts <- counts[, subset_metadata$sample]
  
  # Create DESeqDataSet object
  dds <- DESeqDataSetFromMatrix(
    countData = subset_counts,
    colData = subset_metadata,
    design = ~ donor + condition
  )
