```{r}
analyze_cell_type_degs <- function(merged_seurat, output_dir) {
  library(Seurat)
  library(dplyr)
  library(ComplexHeatmap)
  library(circlize)
  
  # Get all unique cell types
  cell_types <- unique(merged_seurat$sctype2)
  
  all_matrisome_degs <- list()
  
  for (cell_type in cell_types) {
    # Subset Seurat object for the current cell type
    cell_seurat <- subset(merged_seurat, sctype2 == cell_type)
    
    # Make pseudobulk matrix
    cell_seurat[["RNA"]] <- JoinLayers(cell_seurat[["RNA"]])
    pseudo_obj <- AggregateExpression(cell_seurat, assays = "RNA", return.seurat = TRUE, group.by = c("trimester", "donor"))
    Idents(pseudo_obj) <- pseudo_obj$trimester
    pseudo_obj@active.ident <- factor(x = pseudo_obj@active.ident, levels = c("first", "early", "mid"))
    pseudo_obj <- NormalizeData(pseudo_obj)
    pseudo_obj <- ScaleData(pseudo_obj, features = rownames(pseudo_obj))
    
    # Perform DESeq2 analysis
    all_results <- lapply(levels(pseudo_obj), function(trim) {
      result <- perform_deseq2(pseudo_obj, trim)
      result$trimester <- trim
      return(result)
    })
    
    # Combine all results
    final_results <- do.call(rbind, all_results)
    final_results$trimester <- factor(final_results$trimester, levels = c("first", "early", "mid"))
    final_results <- final_results[order(final_results$trimester), ]
    
    # Save DEG results
    write.csv(final_results, file.path(output_dir, paste0(cell_type, "_temporal_de_results.csv")), row.names = FALSE)
    
    # Subset matrisome markers
    matrisome_deg <- subset (final_results, subset = final_results$gene %in% mat_ndd$Annotated.Gene)
    
    # Add cell_type column
    matrisome_deg$cell_type <- cell_type
    
    # Append to the list
    all_matrisome_degs[[cell_type]] <- matrisome_deg
    
    # Save matrisome DEG results
    write.csv(matrisome_deg, file.path(output_dir, paste0(cell_type, "_temporal_de_matrisome_results.csv")), row.names = FALSE)
    
    # Get top 5 unique matrisome markers
    top5_unique_mat_markers <- matrisome_deg %>%
      filter(padj < 0.05 & log2FoldChange > 1) %>%
      group_by(trimester) %>%
      top_n(5, log2FoldChange) %>%
      ungroup() %>%
      distinct(gene, .keep_all = TRUE)
    
    # Generate heatmap
    Idents(cell_seurat) <- cell_seurat$trimester
    cell_seurat$trimester <- factor(x = cell_seurat$trimester, levels = c("first", "early", "mid"))
    pseudo_seurat <- AggregateExpression(cell_seurat, assays = "RNA", return.seurat = TRUE, group.by = "trimester")
    
    colpal <- c("#7094CD", "#2AB34B", "#F3766E")
    pseudo_mat <- GetAssayData(object = pseudo_seurat, assay = "RNA")
    
    mat <- pseudo_mat[top5_unique_mat_markers$gene, ] %>% as.matrix()
    mat <- t(scale(t(mat)))
    
    cluster_anno <- colnames(pseudo_seurat$RNA)
    
    myCol <- colorRampPalette(c('dodgerblue', 'black', 'yellow'))(50)
    myBreaks <- seq(-2, 2, length.out = 50)
    
    ht <- Heatmap(mat, name = "Expression",
                  column_split = factor(cluster_anno, levels = c("first", "early", "mid")),
                  cluster_columns = FALSE,
                  show_column_dend = FALSE,
                  cluster_column_slices = TRUE,
                  column_title_gp = gpar(fontsize = 12),
                  column_gap = unit(0.5, "mm"),
                  cluster_rows = FALSE,
                  row_order = top5_unique_mat_markers$gene,
                  show_row_dend = FALSE,
                  col = colorRamp2(myBreaks, myCol),
                  row_names_gp = gpar(fontsize = 12),
                  column_title_rot = 90,
                  top_annotation = HeatmapAnnotation(foo = anno_block(gp = gpar(fill = colpal))),
                  show_column_names = FALSE,
                  use_raster = TRUE)
    
    # Save heatmap
    pdf(file.path(output_dir, paste0(cell_type, "_top5_matrisome_heatmap.pdf")), width = 8, height = 6)
    print(ht)
    dev.off()
  }
  # Combine all matrisome_deg results into one dataframe
  combined_matrisome_degs <- do.call(rbind, all_matrisome_degs)
  
  # Save the combined results
  write.csv(combined_matrisome_degs, file.path(output_dir, "combined_temporal_de_matrisome_results.csv"), row.names = FALSE)
  
  # Return the combined dataframe
  return(combined_matrisome_degs)
}
