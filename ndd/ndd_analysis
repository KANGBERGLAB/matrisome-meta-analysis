perform_deseq2 <- function(seurat_obj, trimester) {
  # Create a binary condition vector
  condition <- ifelse(seurat_obj$trimester == trimester, trimester, "Other")
  
  # Export count matrix
  counts <- GetAssayData(seurat_obj, slot = "counts")
  
  # Create sample info
