## 15. temporal DEGs in each cell type
clear out ls
```{r}
rm(list = setdiff(ls(), "merged_seurat"))
gc()
```
```{r}
first <- c(8, 9, 10, 10.5, 11, 12)
early_second <- c(13, 15, 16, 17, 18, 19)
mid_second <- c(20, 22, 23, 25, 26)

merged_seurat2 <- merged_seurat
table(merged_seurat2$gestation)
merged_seurat2$trimester <- ifelse(merged_seurat2$gestation %in% first, "first",
                                   ifelse(merged_seurat2$gestation %in% early_second, "early",
                                          "mid"))
table(merged_seurat2$trimester)

nsc <- c("vRG", "oRG", "tRG")
merged_seurat2$sctype2 <- ifelse(merged_seurat2$sctype %in% nsc, "NSC",
                                as.character(merged_seurat2$sctype))
```

```{r}
output_dir <- "~/cell_type_analysis_results"
dir.create(output_dir, showWarnings = FALSE)

results <- analyze_cell_type_degs(merged_seurat2, output_dir)
```

```{r}
filtered_degs <- results %>%
  filter(padj < 0.05 & log2FoldChange > 1)

freq_table <- filtered_degs %>%
  group_by(cell_type, trimester) %>%
  summarise(count = n(), .groups = 'drop')


colpal <- c("#7094CD", "#2AB34B", "#F3766E")

library(ggplot2)

cell_levels <- c("NSC", "IPC", "Imm.GExN","M.GExN","Unknown","GABA IN","Astrocyte","OPC","Microglia","Endothelial")

freq_table$cell_type <- factor(freq_table$cell_type, levels = cell_levels)

p <- ggplot(freq_table, aes(x = cell_type, y = count, fill = trimester)) +
  geom_bar(stat = "identity", position = "stack") +
  scale_fill_manual(values = colpal) +
  geom_text(aes(label = count), position = position_stack(vjust = 0.5), size = 3) +
  labs(title = "Frequency of DEGs by Cell Type and Trimester", x = "Cell Type", y = "Frequency of DEGs") +
  theme_clean() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

print(p)

```
