## 9. WGCNA to identify coexpression modules of LGALS3 and S100B

clear out ls
```{r}
rm(list = setdiff(ls(), "merged_seurat"))
gc()
```

Get a count matrix
```{r}
merged_seurat2 <- merged_seurat
nsc <- c("vRG", "oRG", "tRG")
gexn <- c("Imm.GExN","M.GExN")
merged_seurat2$sctype2 <- ifelse(merged_seurat2$sctype %in% nsc, "NSC",
                                ifelse (merged_seurat2$sctype %in% gexn, "GExN",
                                as.character(merged_seurat2$sctype)))

merged_seurat2[["RNA"]] <- JoinLayers(merged_seurat2[["RNA"]])
pseudo_obj <- AggregateExpression(merged_seurat2, assays = "RNA", return.seurat = T, group.by = c("sctype2", "donor"))
table(pseudo_obj$sctype2)
Idents(pseudo_obj) <- pseudo_obj$sctype2
cell_levels <- c("NSC", "IPC", "GExN","Unknown","GABA IN","Astrocyte","OPC","Microglia","Endothelial")
pseudo_obj@active.ident <- factor(x = pseudo_obj@active.ident, levels = cell_levels)

neurolin_celltype <- c("NSC", "IPC", "GExN")
subset_pseudo_obj <- subset (pseudo_obj, sctype2 %in% neurolin_celltype) #use NSC,IPC,GExN only to identify LGALS3
subset_pseudo_obj <- NormalizeData(subset_pseudo_obj)
subset_pseudo_obj <- ScaleData(subset_pseudo_obj,features = rownames(subset_pseudo_obj))
expr_matrix <- GetAssayData(subset_pseudo_obj, slot = "scale.data")


#check the presence of my gene of interest
gene_of_interest <- "LGALS3"
if(gene_of_interest %in% rownames(expr_matrix)) {
  print(paste("The gene", gene_of_interest, "is present in the expression matrix."))
}
```

set up WGCNA parameter
```{r}
# Choose a soft-thresholding power
powers = c(c(1:10), seq(from = 12, to = 20, by = 2))
sft <- pickSoftThreshold(t(expr_matrix), powerVector = powers, verbose = 5, RsquaredCut = 0.7)

# Choose the power based on the scale-free topology fit index
power <- sft$powerEstimate
```

construct module network
```{r}
net <- blockwiseModules(t(expr_matrix), 
                        power = power,
                        TOMType = "unsigned", 
                        minModuleSize = 10,
                        reassignThreshold = 0, 
                        mergeCutHeight = 0.25,
                        numericLabels = TRUE, 
                        pamRespectsDendro = FALSE,
                        saveTOMs = TRUE,
                        saveTOMFileBase = "TOM",
                        verbose = 3)

moduleColors <- labels2colors(net$colors)
```

```{r}
print(table(net$goodGenes))
print(table(net$colors))
print(head(net$colors))
module_df <- data.frame(
  gene_id = names(net$colors),
  colors = labels2colors(net$colors)
)
```

find module of that contains LGALS3
```{r}
gene_of_interest <- "LGALS3"
gene_of_interest %in% module_df$gene_id
module_df[module_df$gene_id == "LGALS3",]
gene_module <- moduleColors[which(module_df$gene_id == gene_of_interest)]
coexpressed_genes <- module_df$gene_id[moduleColors == gene_module]
```

```{r}
gsg = goodSamplesGenes(expr_matrix, verbose = 3)
gsg$allOK
```

make adjacency matrix of genes in the module associated with LGALS3
```{r}
library(igraph)

# Calculate topological overlap
TOM <- TOMsimilarityFromExpr(t(expr_matrix), power = power)
TOM[1:5,1:5] # missing col and rownames
rownames(TOM) <- rownames(expr_matrix)
colnames(TOM) <- rownames(expr_matrix)
TOM[1:5,1:5]
# Subset the TOM to only include genes in the module of interest
module_TOM <- TOM[coexpressed_genes, coexpressed_genes]

# Convert TOM to a network
network <- graph_from_adjacency_matrix(module_TOM, mode = "undirected", weighted = TRUE, diag = FALSE)

# Plot the network
plot(network, vertex.label = NA, vertex.size = 3, edge.arrow.size = 0.1)
```

Plot top 20 coexpressed genes
```{r}

gene_row <- module_TOM[gene_of_interest, ]

# Sort the genes by their connection strength to your gene of interest
sorted_genes <- sort(gene_row, decreasing = TRUE)

# Get the top 10 most coexpressed genes (excluding the gene of interest itself)
top_20_genes <- names(sorted_genes)[2:21]

# Include your gene of interest in the list
genes_to_plot <- c(gene_of_interest, top_20_genes)

# Subset the TOM to include only these genes
subset_TOM <- module_TOM[genes_to_plot, genes_to_plot]

# Convert the subset TOM to a network
network <- graph_from_adjacency_matrix(subset_TOM, mode = "undirected", weighted = TRUE, diag = FALSE)

# Plot the network
plot(network, 
     vertex.label = V(network)$name,  # Use gene names as labels
     vertex.size = 5,  
     vertex.label.cex = 1,  
     vertex.label.dist = 1.5, 
     vertex.color = adjustcolor("skyblue", alpha.f = 0.5),
     edge.width = E(network)$weight * 5,  
     edge.color = adjustcolor("gray", alpha.f = 0.5),
     layout = layout_with_fr(network) 
)

# Add a title to the plot
title(main = paste("Top 20 genes coexpressed with", gene_of_interest), cex.main = 1.2)
```

