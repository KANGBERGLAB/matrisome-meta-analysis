```{r}
library(dplyr)
process_df <- function(df, label) {
  df %>%
    filter(p_val_adj < 0.05) %>%
    filter(avg_log2FC > 1) %>%
    top_n(10, avg_log2FC) %>%
    mutate(source = label)
}

df_list <- list(c14.markers, c23.markers, c28.markers)
labels <- c("c14", "c23", "c28")
processed_dfs <- list()


for (i in 1:length(df_list)) {
  processed_dfs[[i]] <- process_df(df_list[[i]], labels[i])
}

# Combine all processed data frames
vrg_combined_markers <- bind_rows(processed_dfs)
head(vrg_combined_markers)
```
