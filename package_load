for(x in seq_along(bioc.pkgs)){
  x.bioc <- bioc.pkgs[x]
  if(!require(x.bioc, quietly = TRUE)){
    BiocManager::install(x.bioc)
  }
}


for(x in seq_along(cran.pkgs)){
  x.cran <- cran.pkgs[x]
  if(!require(x.cran, quietly = TRUE)){
    install.packages(x.cran)
  }
}


