## 5. Identification of matrisome cell type markers
clear out ls
```{r}
rm(list = setdiff(ls(), "merged_seurat"))
gc()
```

```{r}
nsc <- c("vRG", "oRG", "tRG")

merged_seurat$sctype2 <- ifelse(merged_seurat$sctype %in% nsc, "NSC",
                                as.character(merged_seurat$sctype))

table(merged_seurat$sctype)
table(merged_seurat$sctype2)
```

make pseudobulk matrix
```{r}
merged_seurat2 <- merged_seurat
merged_seurat2[["RNA"]] <- JoinLayers(merged_seurat2[["RNA"]])
pseudo_obj <- AggregateExpression(merged_seurat, assays = "RNA", return.seurat = T, group.by = c("sctype2", "donor"))
table(pseudo_obj$sctype2)
Idents(pseudo_obj) <- pseudo_obj$sctype2
cell_levels <- c("NSC", "IPC", "Imm.GExN","M.GExN","Unknown","GABA IN","Astrocyte","OPC","Microglia","Endothelial")
pseudo_obj@active.ident <- factor(x = pseudo_obj@active.ident, levels = cell_levels)
pseudo_obj <- NormalizeData(pseudo_obj)
pseudo_obj <- ScaleData(pseudo_obj,features = rownames(pseudo_obj))
```
# Get all unique cell types
cell_types <- unique(Idents(pseudo_obj))

# Perform DESeq2 for each cell type
all_results <- lapply(cell_types, function(ct) {
  result <- perform_deseq2(pseudo_obj, ct)
  result$cell_type <- ct
  return(result)
})

# Combine all results
final_results <- do.call(rbind, all_results)
cell_levels <- c("NSC", "IPC", "Imm.GExN","M.GExN","Unknown","GABA IN","Astrocyte","OPC","Microglia","Endothelial")
final_results$cell_type <- factor(final_results$cell_type, levels = cell_levels)
final_results <- final_results[order(final_results$cell_type), ]
head(final_results)

import matrisome db and subset matrisome markers
```{r}
matrisome <- read.table("Hs_Matrisome_Masterlist.csv", header = T, sep = ',')
#extract gene symbols
matrisome_list <- matrisome$Gene_Symbol

matrisome_deg <- subset (final_results, subset = final_results$gene %in% matrisome_list)
table (matrisome_deg$cluster)
# Save results
write.csv(matrisome_deg, "all_cell_types_de_matrisome_results_merged_NSC.csv", row.names = FALSE)

sig_matrisome_markers <- matrisome_deg %>%
  filter(padj < 0.05 & log2FoldChange > 1)
table(sig_matrisome_markers$cell_type)

top10_matrisome_markers <- matrisome_deg %>%
  filter(padj < 0.05) %>%
  group_by(cell_type) %>%
  top_n(10,log2FoldChange)
```

