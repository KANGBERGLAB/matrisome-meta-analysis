Identify duplicated marker genes and select unique marker genes
```{r}
dup_mat_markers <- sig_matrisome_markers[duplicated(sig_matrisome_markers$gene), ]
table (dup_mat_markers$cell_type)
unique_mat_markers <- sig_matrisome_markers[unique(sig_matrisome_markers$gene), ]
table (unique_mat_markers$cell_type)
top10_unique_mat_markers <- unique_mat_markers %>%
  group_by(cell_type) %>%
  top_n(10,log2FoldChange)
```

