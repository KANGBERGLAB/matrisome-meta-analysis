## 16. Cell to cell interaction analysis
clear out ls
```{r}
rm(list = setdiff(ls(), "merged_seurat"))
gc()
```

prepare data and scRNA-seq matrix
```{r}
matrisome <- read.table("Hs_Matrisome_Masterlist.csv", header = T, sep = ',')
#extract gene symbols
matrisome_list <- matrisome$Gene_Symbol

merged_seurat[["RNA"]] <- JoinLayers(merged_seurat[["RNA"]])
raw_mat <- GetAssayData(object = merged_seurat, assay = "RNA")
meta = merged_seurat@meta.data
cell.use = rownames(meta)
unique(meta$sctype)

matrisome_feat <- intersect(rownames(merged_seurat$RNA), matrisome_list)
matrisome_mat<- raw_mat[matrisome_feat, ] %>%
  as.matrix()
```


Import matrix to cellchat matrix and load CellChat DB
```{r}
library(CellChat)
cellchat <- createCellChat(object = matrisome_mat, meta = meta, group.by = "sctype")
CellChatDB <- CellChatDB.human
showDatabaseCategory(CellChatDB)
CellChatDB.use <- CellChatDB
cellchat@DB <- CellChatDB.use


cellchat <- subsetData(cellchat)
future::plan("multisession", workers = 4) # do parallel
options(future.globals.maxSize = +Inf)

cellchat <- identifyOverExpressedGenes(cellchat)
cellchat <- identifyOverExpressedInteractions(cellchat)
gc()
```

Compute CCI network
```{r}
ptm = Sys.time()
cellchat <- computeCommunProb(cellchat, type = "triMean")
cellchat <- filterCommunication(cellchat, min.cells = 10)
cellchat <- computeCommunProbPathway(cellchat)
cellchat <- aggregateNet(cellchat)
execution.time = Sys.time() - ptm
print(as.numeric(execution.time, units = "secs"))
cci_strength <- as.data.frame(cellchat@net$weight)
cci_strength
```

Visualise
```{r}
colpal <- c("#C7EBB1", "#FFD5FF", "#34854D", "#DEB0B0","#F26378", "#CA2F40", "#81B1DE","#C58862", "#7F517D", "#33608C", "#F5CA61", "#49525E")
cell_groups <- levels(cellchat@idents)
color.use <- setNames(colpal[1:length(cell_groups)], cell_groups)
groupSize <- as.numeric(table(cellchat@idents))
par(mfrow = c(1,2), xpd=TRUE)
netVisual_circle(cellchat@net$count, vertex.weight = groupSize, weight.scale = T, label.edge= F, title.name = "Number of interactions", color.use = color.use)
netVisual_circle(cellchat@net$weight, vertex.weight = groupSize, weight.scale = T, label.edge= F, title.name = "Interaction weights/strength", color.use = color.use)
```

```{r}
mat <- cellchat@net$weight
