Analyse contributions
```{r}
pathways <- cellchat@netP$pathways
all_contributions <- list()
for (pathway in pathways) {
  contribution_data <- netAnalysis_contribution(cellchat, signaling = pathway, return.data = TRUE, thresh = 0.05)
  lr_contribution <- contribution_data$LR.contribution
  lr_contribution$pathway <- pathway  # Add a column to indicate the pathway
  all_contributions[[pathway]] <- lr_contribution
}

combined_lr_contribution_df <- do.call(rbind, all_contributions)


netAnalysis_contribution(cellchat, signaling = "PTN")
netAnalysis_contribution(cellchat, signaling = "MK")
netAnalysis_contribution(cellchat, signaling = "SEMA6")
```

