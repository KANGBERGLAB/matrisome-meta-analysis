make pseudobulk matrix
```{r}
merged_seurat2 <- merged_seurat
cell_levels <- c("NSC","IPC","GExN")
neurolin_seurat <- subset (merged_seurat2, sctype2 %in% cell_levels)
neurolin_seurat[["RNA"]] <- JoinLayers(neurolin_seurat[["RNA"]])
pseudo_obj <- AggregateExpression(neurolin_seurat, assays = "RNA", return.seurat = T, group.by = c("sctype2", "donor"))
table(pseudo_obj$sctype2)
Idents(pseudo_obj) <- pseudo_obj$sctype2
pseudo_obj@active.ident <- factor(x = pseudo_obj@active.ident, levels = cell_levels)
pseudo_obj <- NormalizeData(pseudo_obj)
pseudo_obj <- ScaleData(pseudo_obj,features = rownames(pseudo_obj))
```

Compare gene expression
```{r}
library(Seurat)
library(DESeq2)
library(dplyr)

# Function to perform DESeq2 analysis for one cell type vs all others
perform_deseq2 <- function(seurat_obj, cell_type) {
  # Create a binary condition vector
  condition <- ifelse(Idents(seurat_obj) == cell_type, cell_type, "Other")
  
  # Export count matrix
  counts <- GetAssayData(seurat_obj, slot = "counts")
  
  # Create sample info
  sample_info <- data.frame(
    condition = condition,
    row.names = colnames(counts)
  )
  
  # Create DESeqDataSet object
  dds <- DESeqDataSetFromMatrix(countData = counts,
                                colData = sample_info,
                                design = ~ condition)
  
  # Filter low count genes
  keep <- rowSums(counts(dds)) >= 10
  dds <- dds[keep,]
  
  # Run DESeq2
  dds <- DESeq(dds)
  
  # Get results
  res <- results(dds, contrast = c("condition", cell_type, "Other"))
  
  # Process results
  de_genes <- as.data.frame(res) %>%
    dplyr::select(log2FoldChange, padj) %>%
    dplyr::arrange(padj) %>%
    na.omit()
  
  de_genes$gene <- rownames(de_genes)
  de_genes <- de_genes %>% dplyr::select(gene, log2FoldChange, padj)
  
  return(de_genes)
}

# Get all unique cell types
cell_types <- unique(Idents(pseudo_obj))

# Perform DESeq2 for each cell type
all_results <- lapply(cell_types, function(ct) {
  result <- perform_deseq2(pseudo_obj, ct)
  result$cell_type <- ct
  return(result)
})

# Combine all results
final_results <- do.call(rbind, all_results)
final_results$cell_type <- factor(final_results$cell_type, levels = cell_levels)
final_results <- final_results[order(final_results$cell_type), ]
head(final_results)
write.csv(final_results, "neurolin_deg.csv", row.names = TRUE)
```

